# Local secrets for `npm run dev`. Copy to `.dev.vars` (gitignored) and fill
# in. Production values are set with `wrangler secret put <NAME>` (S10).

# NextAuth session/cookie encryption secret. Generate one with:
#   openssl rand -base64 32        (or: npx auth secret)
AUTH_SECRET=""

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials).
# Application type: Web application. Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# S6 agentic layer (PRD 3.6). DEEPSEEK_API_KEY is required for POST
# /api/agent/run (an OpenRouter key, https://openrouter.ai/keys; DeepSeek V4
# Flash does all triage + drafting, plus the web-search fallback for live
# news); without it the endpoint answers 503. XAI_API_KEY
# (https://console.x.ai) enables the primary live X.com news search; without
# it the searcher uses DeepSeek web search alone.
DEEPSEEK_API_KEY=""
XAI_API_KEY=""

# Optional model overrides (defaults live in lib/agent/models/):
#   DEEPSEEK_MODEL="deepseek/deepseek-v4-flash"
#   XAI_MODEL="grok-4.3"
# Optional Cloudflare AI Gateway routing (PRD 3.8): caching + analytics +
# rate limiting. Leave unset to call the providers directly.
#   DEEPSEEK_BASE_URL="https://gateway.ai.cloudflare.com/v1/{account_id}/osooly/openrouter/v1"
#   XAI_BASE_URL is direct-only for now (the gateway grok provider lacks the
#   Responses API needed for x_search).
# Optional RSS override for the news RAG corpus (lib/rag/embed-news.ts):
#   NEWS_FEEDS="stocks=https://example.com/rss,jewelry=https://example.com/gold.rss"
